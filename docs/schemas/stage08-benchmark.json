{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "comparisons": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "paramKey": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "contractValue": {
            "type": [
              "number",
              "string"
            ]
          },
          "marketMedianValue": {
            "type": [
              "number",
              "string"
            ]
          },
          "sampleSize": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "hasSufficientSample": {
            "type": "boolean"
          },
          "classification": {
            "type": "string",
            "enum": [
              "standard_rynkowy",
              "odbiega_od_normy",
              "skrajny",
              "brak_danych"
            ]
          },
          "explanation": {
            "type": "string"
          }
        },
        "required": [
          "paramKey",
          "label",
          "contractValue",
          "sampleSize",
          "hasSufficientSample",
          "classification",
          "explanation"
        ],
        "additionalProperties": false
      }
    },
    "benchmarkVersion": {
      "type": "string"
    }
  },
  "required": [
    "comparisons",
    "benchmarkVersion"
  ],
  "additionalProperties": false
}