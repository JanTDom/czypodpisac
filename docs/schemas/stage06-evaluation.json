{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "evaluations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "clauseId": {
            "type": "string",
            "minLength": 1
          },
          "checklistItemId": {
            "type": "string"
          },
          "ocena": {
            "type": "string",
            "enum": [
              "czerwony",
              "żółty",
              "zielony"
            ]
          },
          "tytulPoLudzku": {
            "type": "string",
            "minLength": 5,
            "maxLength": 120
          },
          "doslownyCytatZUmowy": {
            "type": "string",
            "minLength": 1
          },
          "uzasadnienie": {
            "type": "string",
            "minLength": 10
          },
          "zrodlaIds": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "pewnosc": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "kwotaRyzyka": {
            "type": "number",
            "minimum": 0
          },
          "zalozeniaKwoty": {
            "type": "string"
          },
          "propozycjaZmianyKierunek": {
            "type": "string"
          }
        },
        "required": [
          "clauseId",
          "ocena",
          "tytulPoLudzku",
          "doslownyCytatZUmowy",
          "uzasadnienie",
          "zrodlaIds",
          "pewnosc"
        ],
        "additionalProperties": false
      }
    },
    "totalEvaluated": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "rawModelName": {
      "type": "string"
    },
    "evaluatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    }
  },
  "required": [
    "evaluations",
    "totalEvaluated",
    "evaluatedAt"
  ],
  "additionalProperties": false
}