    "benchmarks": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "paramKey": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "contractValue": {
            "type": [
              "number",
              "string"
            ]
          },
          "marketMedianValue": {
            "type": [
              "number",
              "string"
            ]
          },
          "sampleSize": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
