                  "type": "string"
                }
              },
              "pewnosc": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "geminiVerifierVerdict": {
                "type": "string",
                "enum": [
                  "popiera",
                  "nie_popiera",
                  "niepewne"
                ]
              },
              "kwotaRyzyka": {
                "type": "number",
                "minimum": 0
              },
              "zalozeniaKwoty": {
                "type": "string"
              },
              "powodOdrzuceniaLubNiepewnosci": {
                "type": "string"
