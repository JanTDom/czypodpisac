    "partyStatus": {
      "type": "string",
      "enum": [
        "consumer",
        "consumer_entrepreneur",
        "business"
      ]
    },
    "verdictOneSentence": {
      "type": "string",
      "minLength": 10,
      "maxLength": 180
    },
    "counts": {
      "type": "object",
      "properties": {
        "red": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "yellow": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "missing": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "green": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "red",
        "yellow",
        "missing",
        "green"
      ],
      "additionalProperties": false
    },
    "totalRiskAmount": {
      "type": "number",
      "minimum": 0
    },
    "totalRiskAssumptions": {
      "type": "string"
    },
    "recommendedAction": {
      "type": "string",
      "enum": [
        "mozesz_podpisac",
        "popros_o_zmiany",
        "negocjuj",
        "skonsultuj_z_prawnikiem"
