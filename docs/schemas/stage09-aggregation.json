              },
              "clauseId": {
                "type": "string",
                "minLength": 1
              },
              "checklistItemId": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "verified",
                  "needs_verification",
                  "rejected"
                ]
              },
              "ocena": {
                "type": "string",
                "enum": [
                  "czerwony",
                  "żółty",
                  "zielony"
                ]
