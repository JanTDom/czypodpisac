{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contractType": {
      "type": "string",
      "enum": [
        "najem_lokalu_mieszkalnego",
        "najem_okazjonalny",
        "najem_instytucjonalny",
        "najem_lokalu_uzytkowego",
        "umowa_o_prace",
        "b2b_uslugi_freelancer",
        "zlecenie",
        "dzielo",
        "umowa_deweloperska",
        "kredyt_konsumencki",
        "leasing_konsumencki",
        "owu_ubezpieczenie",
        "telekomunikacyjna",
        "inna_nieznana"
      ]
    },
    "userRole": {
      "type": "string",
      "enum": [
        "najemca",
        "wynajmujacy",
        "zamawiajacy",
        "wykonawca",
        "pracownik",
        "pracodawca",
        "nabywca",
        "deweloper",
        "klient"
      ]
    },
    "partyStatus": {
      "type": "string",
      "enum": [
        "consumer",
        "consumer_entrepreneur",
        "business"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "needsUserClarification": {
      "type": "boolean"
    },
    "clarificationQuestions": {
      "maxItems": 2,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 5
          },
          "description": {
            "type": "string"
          },
          "options": {
            "minItems": 2,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "value",
                "label"
              ],
              "additionalProperties": false
            }
          },
          "selectedValue": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "question",
          "options"
        ],
        "additionalProperties": false
      }
    },
    "detectedParties": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string"
          },
          "nameOrIdentifier": {
            "type": "string"
          },
          "isIdentifiedAsConsumer": {
            "type": "boolean"
          }
        },
        "required": [
          "role",
          "isIdentifiedAsConsumer"
        ],
        "additionalProperties": false
      }
    },
    "detectedFinancials": {
      "type": "object",
      "properties": {
        "rentAmount": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "currency": {
          "default": "PLN",
          "type": "string"
        },
        "depositAmount": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "currency"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contractType",
    "userRole",
    "partyStatus",
    "confidence",
    "needsUserClarification",
    "clarificationQuestions",
    "detectedParties"
  ],
  "additionalProperties": false
}