{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "findingId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "clauseNumber": {
      "type": "string"
    },
    "originalText": {
      "type": "string"
    },
    "softReplacementText": {
      "type": "string",
      "minLength": 5
    },
    "firmReplacementText": {
      "type": "string",
      "minLength": 5
    },
    "legalRationale": {
      "type": "string",
      "minLength": 10
    },
    "isApprovedTemplate": {
      "type": "boolean"
    },
    "needsLawyerVerification": {
      "type": "boolean"
    }
  },
  "required": [
    "findingId",
    "clauseNumber",
    "originalText",
    "softReplacementText",
    "firmReplacementText",
    "legalRationale",
    "isApprovedTemplate",
    "needsLawyerVerification"
  ],
  "additionalProperties": false
}