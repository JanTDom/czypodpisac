{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "recipientRole": {
      "type": "string"
    },
    "subject": {
      "type": "string",
      "minLength": 5
    },
    "bodySoft": {
      "type": "string",
      "minLength": 20
    },
    "bodyFirm": {
      "type": "string",
      "minLength": 20
    },
    "bulletPointsList": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mailtoUrl": {
      "type": "string"
    }
  },
  "required": [
    "recipientRole",
    "subject",
    "bodySoft",
    "bodyFirm",
    "bulletPointsList"
  ],
  "additionalProperties": false
}